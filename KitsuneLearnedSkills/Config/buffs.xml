				<triggered_effect trigger="onSelfDamagedBlock" action="ModifyCVar" cvar="$kls_harvest" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="harvestingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_harvest" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
			</effect_group>

			<!--
				salvagingSkill -> craftingSalvageTools
				The killing blow on a block fires onSelfDestroyedBlock INSTEAD
				of onSelfDamagedBlock (ItemActionAttack.Hit). Most salvage
				targets (sinks, toilets, cabinets, appliances) break in a few
				hits, so 0.10.0 lost a big share of salvage work. Count both.
			-->
			<effect_group>
				<triggered_effect trigger="onSelfDamagedBlock" action="ModifyCVar" cvar="$kls_salvage" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDestroyedBlock" action="ModifyCVar" cvar="$kls_salvage" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDamagedBlock" action="AddProgressionLevel" progression_name="craftingSalvageTools" level="1">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_salvage" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDestroyedBlock" action="AddProgressionLevel" progression_name="craftingSalvageTools" level="1">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_salvage" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDamagedBlock" action="ShowToolbeltMessage" message_key="klsMsgSalvageTools" message="Your salvage crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_salvage" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDestroyedBlock" action="ShowToolbeltMessage" message_key="klsMsgSalvageTools" message="Your salvage crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_salvage" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDamagedBlock" action="ModifyCVar" cvar="$kls_salvage" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_salvage" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDestroyedBlock" action="ModifyCVar" cvar="$kls_salvage" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_salvage" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
			</effect_group>

			<!--
				salvagingSkill on a vehicle wreck -> craftingVehicles
				Vanilla tags every car, truck, bus and forklift wreck with
				challenge_cars (the "harvest engines from cars" challenges use
				it). A few deco blocks share the tag (air conditioners, house
				and car radiators); they count too. The same hit still feeds
				Salvage Tools through the group above.
			-->
			<effect_group>
				<triggered_effect trigger="onSelfDamagedBlock" action="ModifyCVar" cvar="$kls_wreck" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="TriggerHasTags" tags="challenge_cars"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDamagedBlock" action="AddProgressionLevel" progression_name="craftingVehicles" level="1">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="TriggerHasTags" tags="challenge_cars"/>
					<requirement name="CVarCompare" cvar="$kls_wreck" operation="GTE" value="@$kls_pace_wreck"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDamagedBlock" action="ShowToolbeltMessage" message_key="klsMsgVehicles" message="Your vehicle crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="TriggerHasTags" tags="challenge_cars"/>
					<requirement name="CVarCompare" cvar="$kls_wreck" operation="GTE" value="@$kls_pace_wreck"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfDamagedBlock" action="ModifyCVar" cvar="$kls_wreck" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="salvagingSkill"/>
					<requirement name="TriggerHasTags" tags="challenge_cars"/>
					<requirement name="CVarCompare" cvar="$kls_wreck" operation="GTE" value="@$kls_pace_wreck"/>
				</triggered_effect>
			</effect_group>

			<!--
				repair tools -> craftingRepairTools
				Vanilla only gives repairingSkill to the NAILGUN (a level 26
				unlock). The claw hammer is tagged repairingTools and the stone
				axe only repairTool, so 0.10.0 never counted either and the
				line was stuck. repairTool is on all three (and is what mod
				repair tools copy). Upgrading a block (onSelfUpgradedBlock,
				once per finished upgrade) counts as well as repairing one:
				upgrading is most of what a hammer ever does.
			-->
			<effect_group>
				<triggered_effect trigger="onSelfRepairBlock" action="ModifyCVar" cvar="$kls_repair" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfUpgradedBlock" action="ModifyCVar" cvar="$kls_repair" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfRepairBlock" action="AddProgressionLevel" progression_name="craftingRepairTools" level="1">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_repair" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfUpgradedBlock" action="AddProgressionLevel" progression_name="craftingRepairTools" level="1">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_repair" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfRepairBlock" action="ShowToolbeltMessage" message_key="klsMsgRepairTools" message="Your repair crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_repair" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfUpgradedBlock" action="ShowToolbeltMessage" message_key="klsMsgRepairTools" message="Your repair crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_repair" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfRepairBlock" action="ModifyCVar" cvar="$kls_repair" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_repair" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfUpgradedBlock" action="ModifyCVar" cvar="$kls_repair" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="repairTool,repairingTools,repairingSkill"/>
					<requirement name="CVarCompare" cvar="$kls_repair" operation="GTE" value="@$kls_pace_tool"/>
				</triggered_effect>
			</effect_group>

			<!-- foodSkill -> craftingFood -->
			<effect_group>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$kls_food" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="foodSkill"/>
				</triggered_effect>
