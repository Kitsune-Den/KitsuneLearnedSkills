			<stack_type value="ignore"/>
			<!-- clubSkill -> craftingClubs -->
			<effect_group>
				<triggered_effect trigger="onSelfKilledOther" action="ModifyCVar" cvar="$kls_clubs" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="clubSkill"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfKilledOther" action="AddProgressionLevel" progression_name="craftingClubs" level="1">
					<requirement name="HoldingItemHasTags" tags="clubSkill"/>
					<requirement name="CVarCompare" cvar="$kls_clubs" operation="GTE" value="@$kls_pace_weapon"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfKilledOther" action="ShowToolbeltMessage" message_key="klsMsgClubs" message="Your club crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="clubSkill"/>
					<requirement name="CVarCompare" cvar="$kls_clubs" operation="GTE" value="@$kls_pace_weapon"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfKilledOther" action="ModifyCVar" cvar="$kls_clubs" operation="set" value="0">
					<requirement name="HoldingItemHasTags" tags="clubSkill"/>
					<requirement name="CVarCompare" cvar="$kls_clubs" operation="GTE" value="@$kls_pace_weapon"/>
				</triggered_effect>
			</effect_group>

