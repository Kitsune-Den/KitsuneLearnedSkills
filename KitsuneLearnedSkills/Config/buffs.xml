				</triggered_effect>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ShowToolbeltMessage" message_key="klsMsgFood" message="Your cooking crafting knowledge grows.">
					<requirement name="HoldingItemHasTags" tags="foodSkill"/>
					<requirement name="CVarCompare" cvar="$kls_food" operation="GTE" value="@$kls_pace_use"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$kls_food" operation="set" value="0">
