					<requirement name="CVarCompare" cvar="$kls_food" operation="GTE" value="@$kls_pace_use"/>
				</triggered_effect>
			</effect_group>

			<!-- medicalSkill -> craftingMedical -->
			<effect_group>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$kls_medical" operation="add" value="1">
					<requirement name="HoldingItemHasTags" tags="medicalSkill"/>
				</triggered_effect>
